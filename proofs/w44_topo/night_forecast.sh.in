#!/usr/bin/env bash
# Frozen combined launcher, manager sequencer only. Rendered once from committed tools.
# TOPO_CPUS only overrides CPU placement (default = lane cores); it changes no launcher logic.
set -euo pipefail
export JAX_PLATFORMS=cpu GPUWRF_JAX_CACHE=0 PYTHONDONTWRITEBYTECODE=1
if [ -e /tmp/wrf_gpu2_quiet ]; then echo QUIET; exit 3; fi
TOPO_FORECAST_DRIVER=@TOPO_TOOLS@/forecast_driver.py
TOPO_FORECAST_REQUEST=@REQUEST_PATH@
TOPO_FORECAST_DRIVER_SUM=$(sha256sum "$TOPO_FORECAST_DRIVER")
TOPO_FORECAST_REQUEST_SUM=$(sha256sum "$TOPO_FORECAST_REQUEST")
[[ "${TOPO_FORECAST_DRIVER_SUM%% *}" == '@DRIVER_SHA@' ]] || { echo 'forecast driver hash mismatch'; exit 9; }
[[ "${TOPO_FORECAST_REQUEST_SUM%% *}" == '@REQUEST_SHA@' ]] || { echo 'forecast request hash mismatch'; exit 9; }
if [ -e /tmp/wrf_gpu2_quiet ]; then echo QUIET; exit 3; fi; exec taskset -c "${TOPO_CPUS:-8,9,12,24,25,28}" nice -n 19 timeout --signal=TERM --kill-after=15 @CAP_SECONDS@ <USER_HOME>/miniconda3/bin/python "$TOPO_FORECAST_DRIVER" @VARIANT_ARGS@ "$@"
